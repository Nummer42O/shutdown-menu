{
	"version": "2.0.0",
	"tasks": [
    {
      "type": "shell",
      "label": "open-example",

      "command": ["code", "-n", "/home/nummer42o/Downloads/getting-started-tutorial"],

      "group": "none",
      "presentation": {
        "reveal": "never",
        "close": true
      },
      "problemMatcher": [],
      // "runOptions": {"runOn": "folderOpen"},
      "hide": true
    },
    {
      "type": "cmake",
      "label": "Build",
      "detail": "CMake build task.",

      "command": "build",

      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Install",
      "detail": "CMake install task.",

      "command": "/usr/bin/bash",
      "args": [
        "${workspaceFolder}/.vscode/install.bash",
        "${config:cmake.cmakePath}",
        "${workspaceFolder}"
      ],

      "presentation": {
        "echo": false,
        "reveal": "silent",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Uninstall",
      "detail": "CMake uninstall task.",

      "command": "/usr/bin/pkexec",
      "args": [
        "${config:cmake.cmakePath}",
        "--build",
        "${workspaceFolder}/build_install",
        "--config",
        "Release",
        "--target",
        "uninstall",
        "--"
      ],

      "presentation": {
        "echo": false,
        "reveal": "silent",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Test: unit",
      "detail": "Run unit tests (schema, keybind, CLI).",
      "command": "/usr/bin/bash",
      "args": [
        "-lc",
        "cd \"${workspaceFolder}/build\" && ctest --output-on-failure -L unit"
      ],
      "dependsOn": "Build",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Test: all",
      "detail": "Run all CTest tests, including integration tests.",
      "command": "/usr/bin/bash",
      "args": [
        "-lc",
        "cd \"${workspaceFolder}/build\" && ctest --output-on-failure"
      ],
      "dependsOn": "Build",
      "group": {
        "kind": "test"
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Test: schema",
      "detail": "Validate the generated GSettings schema.",
      "command": "/usr/bin/bash",
      "args": [
        "-lc",
        "cd \"${workspaceFolder}/build\" && ctest --output-on-failure -R unit.schema -V"
      ],
      "dependsOn": "Build",
      "group": {
        "kind": "test"
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Test: keybind",
      "detail": "Run the keybind helper tests against a keyfile backend.",
      "command": "/usr/bin/bash",
      "args": [
        "-lc",
        "cd \"${workspaceFolder}/build\" && ctest --output-on-failure -R unit.keybind -V"
      ],
      "dependsOn": "Build",
      "group": {
        "kind": "test"
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Test: Wayland smoke",
      "detail": "Run the application in a private nested GNOME Wayland session.",
      "command": "/usr/bin/bash",
      "args": [
        "-lc",
        "cd \"${workspaceFolder}/build\" && ctest --output-on-failure -R integration.wayland-smoke -V"
      ],
      "dependsOn": "Build",
      "group": {
        "kind": "test"
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Test: X11 smoke",
      "detail": "Run the application against a fresh Xephyr X11 display.",
      "command": "/usr/bin/bash",
      "args": [
        "-lc",
        "cd \"${workspaceFolder}/build\" && ctest --output-on-failure -R integration.x11-smoke -V"
      ],
      "dependsOn": "Build",
      "group": {
        "kind": "test"
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}